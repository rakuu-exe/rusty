# ---- Discord ----
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID, used to register slash commands
DISCORD_CLIENT_ID=
# The single guild this private bot serves
DISCORD_GUILD_ID=

# ---- Supabase ----
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# SERVICE ROLE key -- bypasses RLS. Never expose this client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Credential encryption ----
# 32-byte key, hex encoded (64 hex chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts player_token and FCM credentials at rest.
CREDENTIALS_ENCRYPTION_KEY=

# ---- Behaviour ----
# How often to poll getMapMarkers, in ms. 5000 is safe against the
# 25-token/+3-per-second per-playerId bucket. Do not go below 1000.
POLL_INTERVAL_MS=5000

# IANA timezone used to render event times, e.g. Europe/Tallinn
TIMEZONE=UTC

# Prefix for in-game team chat commands
INGAME_COMMAND_PREFIX=!

LOG_LEVEL=info
